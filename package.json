{
  "name": "toms-crossing-exhibition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-scene-previews.mjs && tsc --noEmit && vite build && node scripts/build-notices.mjs && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs && playwright test",
    "check": "npm run build && npm test",
    "prepare-art": "node scripts/build-scene-previews.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
